        <div class="hn"><div class="n">3.75</div><div class="l">GPA at UT Austin</div></div>
      </div>
      <div class="cta">
        <a class="btn primary" href="#stack">See the stack</a>
        <a class="btn" href="/ashmit-bohora-resume.pdf" target="_blank" rel="noopener noreferrer">Download resume</a>
