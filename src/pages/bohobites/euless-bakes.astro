---
import Base from '../../layouts/Base.astro';

// Personalized pitch page for the Paris Baguette Euless opening (inbound from Vivek, @euless_bakes,
// 2026-09-07). noindex + out of the sitemap on purpose: one reader, one link.
// Every number below was read off the live TikTok profile on the date in MEASURED. Re-pull before editing.

const TIKTOK = 'https://www.tiktok.com/@.bohobites';
const INSTAGRAM = 'https://www.instagram.com/_bohobites';
const YOUTUBE = 'https://www.youtube.com/@bohobites';
const EMAIL = 'bohobitesofficial@gmail.com';

const MEASURED = 'September 7, 2026';
const ACCOUNT = { followers: '7,234', likes: '122.5K', videos: '61' };

// Their spot: 2920 Rio Grande Blvd, Euless (Glade Parks, next to Piada, across from Super Target).
// Driving distance and time from each visit to that address (OSRM, pulled 2026-09-07).
const MID_CITIES = [
  { id: '7655574809987878175', spot: 'Famous Philly Cheese Steak & More', addr: '107 W Harwood Rd, Euless', views: '54.8K', likes: '4,638', posted: 'June 2026', miles: '3.5 mi', mins: '8 min', note: 'Most-watched POV visit on the whole account' },
  { id: '7653892083291278622', spot: 'Pizzeria Sprezza', addr: '1310 Chisholm Trail, Euless', views: '51.2K', likes: '3,395', posted: 'June 2026', miles: '0.5 mi', mins: '2 min', note: 'Same Glade Parks strip as you' },
  { id: '7648761852830272798', spot: 'Manmeet’s Indian Delicacies', addr: '401 W Bedford Euless Rd, Hurst', views: '23.3K', likes: '1,526', posted: 'June 2026', miles: '7.0 mi', mins: '11 min', note: 'Vegetarian counter, Bedford-Euless Rd' },
  { id: '7664102465196805390', spot: 'Jukson Foods', addr: '221 N Main St, Euless', views: '22.2K', likes: '1,407', posted: 'July 2026', miles: '4.6 mi', mins: '9 min', note: 'Nepali food truck, downtown Euless' },
  { id: '7655603342722272543', spot: 'Cosmic Kitchen', addr: '1001 W Harwood Rd, Euless', views: '10.5K', likes: '523', posted: 'June 2026', miles: '2.6 mi', mins: '5 min', note: 'Strip-mall kitchen off Harwood' },
  { id: '7677401130711682335', spot: 'Yaksa Restaurant and Bar', addr: '501 S Industrial Blvd, Euless', views: '8.8K', likes: '209', posted: 'August 2026', miles: '3.9 mi', mins: '7 min', note: 'Last DFW visit before the Austin move' },
];
const MID_CITIES_TOTAL = { posts: '6', views: '170.8K', likes: '11.7K' };

// Everything else filmed at a DFW restaurant (chains and at-home posts excluded).
const DFW_TOTAL = { posts: '15', views: '358.8K' };
const DFW_MORE = [
  { id: '7665945296152628493', spot: 'The Red Chickz, Carrollton', views: '56.3K', note: 'Posted on their grand-opening day' },
  { id: '7574619901168520478', spot: 'A halal spot in Richardson', views: '33.3K', note: 'Next to UT Dallas' },
  { id: '7671861792171232542', spot: 'Flavor Hub, North Richland Hills', views: '22.4K', note: 'Rufe Snow Dr' },
  { id: '7661903602725833997', spot: 'Taqueria Charly 4, Grand Prairie', views: '20.0K', note: 'Pioneer Pkwy' },
  { id: '7660773783799729439', spot: 'Pak-A-Pocket, Fort Worth', views: '19.3K', note: 'Near TCU' },
  { id: '7668323312837217550', spot: 'Watauga Kabab n Kurry', views: '13.3K', note: 'Rufe Snow Dr' },
];

// Audience geography comes from TikTok Studio > Analytics > Followers. Filled by hand from the
// analytics screen, never estimated. Leave null and the section does not render.
const GEO: null | { country: string; countryPct: string; cities: { name: string; pct: string }[]; asOf: string } = null;

const LOGO_ALT = 'BohoBites';
---

<Base
  title="BohoBites in Euless | for the Paris Baguette Glade Parks opening"
  description="Every BohoBites video filmed in Euless and the Mid-Cities, with live view counts and the drive time to 2920 Rio Grande. Prepared for the Paris Baguette Euless opening."
  noindex={true}
>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site">
    <div class="wrap masthead">
      <a class="title" href="/bohobites/" style="text-decoration:none;color:inherit">Boho<span>Bites</span></a>
      <button class="nav-toggle" id="navToggle" aria-label="Menu" aria-expanded="false" aria-controls="mainNav">
        <span></span><span></span><span></span>
      </button>
      <nav aria-label="Main" id="mainNav">
        <div class="nav-sections">
          <a href="#euless">Euless</a>
          <a href="#dfw">Rest of DFW</a>
          {GEO && <a href="#audience">Audience</a>}
          <a href="#opening">The opening</a>
          <a href="/bohobites/">Full kit</a>
        </div>
        <div class="nav-icons">
          <a href={TIKTOK} target="_blank" rel="noopener noreferrer" aria-label="BohoBites on TikTok">
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M9.5 1.5v8.3a2.7 2.7 0 1 1-2.2-2.66" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M9.5 3.2c.5 1.6 1.8 2.7 3.4 2.9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          </a>
          <a href={INSTAGRAM} target="_blank" rel="noopener noreferrer" aria-label="BohoBites on Instagram">
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="1.5" y="1.5" width="13" height="13" rx="4" stroke="currentColor" stroke-width="1.4"/><circle cx="8" cy="8" r="3.2" stroke="currentColor" stroke-width="1.4"/><circle cx="11.6" cy="4.4" r="0.9" fill="currentColor"/></svg>
          </a>
          <a href={YOUTUBE} target="_blank" rel="noopener noreferrer" aria-label="BohoBites on YouTube">
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="1" y="3.5" width="14" height="9" rx="3" stroke="currentColor" stroke-width="1.4"/><path d="M6.7 6.2l3.6 1.8-3.6 1.8V6.2z" fill="currentColor"/></svg>
          </a>
        </div>
      </nav>
    </div>
  </header>

  <main id="main" tabindex="-1">

    <div class="wrap pb-head">
      <p class="eyebrow">For the Paris Baguette opening at Glade Parks</p>
      <h1>Euless is <span class="lit">home turf.</span></h1>
      <p class="pb-dek">
        BohoBites started in Euless. Every visit below is within eleven minutes of 2920 Rio Grande,
        and one of them is half a mile from your door. You asked two questions. Here they are,
        answered with the live numbers on each post.
      </p>
      <div class="cta">
        <a class="btn primary" href="#euless">See the Euless videos</a>
        <a class="btn" href="#opening">The opening</a>
      </div>
    </div>

    <div class="wrap">
      <section class="stats" aria-label="BohoBites in the Mid-Cities">
        <div class="stat">
          <span class="v">{MID_CITIES_TOTAL.posts}</span>
          <span class="l">Euless and Mid-Cities visits</span>
        </div>
        <div class="stat">
          <span class="v">{MID_CITIES_TOTAL.views}</span>
          <span class="l">Views on those six</span>
        </div>
        <div class="stat">
          <span class="v">{DFW_TOTAL.posts}</span>
          <span class="l">DFW restaurant visits</span>
        </div>
        <div class="stat">
          <span class="v">{DFW_TOTAL.views}</span>
          <span class="l">Views across DFW</span>
        </div>
      </section>
      <p class="stamp">
        Account: {ACCOUNT.followers} TikTok followers, {ACCOUNT.likes} likes, {ACCOUNT.videos} videos.
        Counted from the live profile on {MEASURED}.
      </p>
    </div>

    <div class="wrap">
      <section class="panel wide" id="euless">
        <p class="q">Your first question</p>
        <h2>Have you created content in Euless or the Mid-Cities?</h2>
        <p>
          Yes. Six visits, all independent spots, all posted with the full street address in the
          caption. The distance on each card is the drive from that restaurant to 2920 Rio Grande.
          Tap any card to watch the post.
        </p>
        <ul class="cards" aria-label="Videos filmed in Euless and the Mid-Cities">
          {MID_CITIES.map((v) => (
            <li>
              <a href={`${TIKTOK}/video/${v.id}`} target="_blank" rel="noopener noreferrer">
                <span class="thumb">
                  <img src={`/bohobites-posts/${v.id}.jpg`} alt={`Cover frame from the ${v.spot} video`} width="360" height="640" loading="lazy" decoding="async" />
                  <span class="views">{v.views} <small>views</small></span>
                </span>
                <span class="body">
                  <span class="spot">{v.spot}</span>
                  <span class="addr">{v.addr}</span>
                  <span class="dist"><b>{v.miles}</b> from your door, {v.mins} drive</span>
                  <span class="meta">{v.likes} likes, posted {v.posted}</span>
                  <span class="note">{v.note}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p class="small">
          Pizzeria Sprezza sits in the same Glade Parks development as you. The cheesesteak video is
          the most-watched restaurant visit on the account, and it is eight minutes from your door.
        </p>
      </section>
    </div>

    <div class="wrap">
      <section class="panel wide" id="dfw">
        <h2>The rest of DFW</h2>
        <p>
          Same format, wider radius. Fifteen restaurant visits across the metroplex and {DFW_TOTAL.views}
          views between them. The ones outside the Mid-Cities:
        </p>
        <ol class="vids">
          {DFW_MORE.map((v) => (
            <li>
              <a href={`${TIKTOK}/video/${v.id}`} target="_blank" rel="noopener noreferrer">
                <span class="v-views">{v.views}</span>
                <span class="v-body">
                  <span class="v-title">{v.spot}</span>
                  <span class="v-note">{v.note}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
        <p class="small">
          Plus three more in Richardson and North Richland Hills. Worth knowing for a bakery: the
          only caf&eacute; I have filmed so far, a coffee shop in Paris, Texas, did 42.6K. Pastry and
          coffee film well in first person. You watch the case, not a host.
        </p>
      </section>
    </div>

    {GEO && (
      <div class="wrap">
        <section class="panel wide" id="audience">
          <p class="q">Your second question</p>
          <h2>What portion of the audience is in that part of the metroplex?</h2>
          <p>
            Straight from TikTok Studio analytics, as of {GEO.asOf}. {GEO.countryPct} of followers are in
            the {GEO.country}. Top cities:
          </p>
          <ul class="geo" aria-label="Top follower cities">
            {GEO.cities.map((c) => (
              <li><span class="g-pct">{c.pct}</span><span class="g-name">{c.name}</span></li>
            ))}
          </ul>
          <p class="small">
            TikTok reports followers by city, not by suburb, so Euless, Bedford, Hurst, Grapevine and
            Colleyville roll up into the Dallas and Fort Worth lines above.
          </p>
        </section>
      </div>
    )}

    <div class="wrap pb-grid">
      <section class="panel">
        <h2>What a BohoBites video is</h2>
        <p>
          One continuous visit, filmed on smart glasses, so the viewer sees the counter, the case and
          the first bite exactly the way I did. The audio is the real room. Nothing is narrated over
          the top afterward, and the caption ends with your full address and the landmarks people
          actually use: next to Piada, across from Super Target.
        </p>
        <p>
          The Red Chickz in Carrollton is the closest precedent to what you are planning. I filmed
          ahead of their opening, posted on grand-opening day, and the video is at 56.3K.
        </p>
      </section>

      <section class="panel" id="opening">
        <h2>For the opening</h2>
        <ul class="ticks">
          <li>Yes to the creator preview. Give me the date early and I will plan around it.</li>
          <li>One POV visit video on TikTok, timed to your opening week. Instagram and YouTube Shorts on request.</li>
          <li>Full name, street address and the Glade Parks landmarks in the caption, so viewers can find you.</li>
          <li>I say what I actually thought. That is why the numbers above exist.</li>
        </ul>
        <p class="small">
          I am at UT Austin during the week now, so a preview date agreed in advance is the one
          thing I need from you.
        </p>
      </section>
    </div>

    <div class="wrap">
      <section class="panel wide" id="next">
        <h2>Next step</h2>
        <p>
          Tell me what the preview and the opening look like on your side, how many posts you want,
          and the budget you are working with. I will send a plan back the same day.
        </p>
        <div class="cta left">
          <a class="btn primary" href={`mailto:${EMAIL}?subject=Paris%20Baguette%20Euless%20opening`}>{EMAIL}</a>
          <a class="btn" href={TIKTOK} target="_blank" rel="noopener noreferrer">@.bohobites on TikTok</a>
          <a class="btn" href="/bohobites/">Full media kit</a>
        </div>
      </section>
    </div>

    <div class="wrap who">
      <p>
        BohoBites is made by <a href="/">Ashmit Bohora</a>. I film it, edit it, and run the numbers
        behind it myself. Every spot on the account is a place I paid to eat at.
      </p>
    </div>

  </main>

  <footer class="site">
    <div class="wrap">
      <p class="sig">{LOGO_ALT} by <span>Ashmit Bohora</span>, from Euless, now in Austin</p>
      <div class="links">
        <a href="/bohobites/">Media kit</a>
        <a href={TIKTOK} target="_blank" rel="noopener noreferrer">TikTok</a>
        <a href={INSTAGRAM} target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href={YOUTUBE} target="_blank" rel="noopener noreferrer">YouTube</a>
        <a href={`mailto:${EMAIL}`}>Email</a>
      </div>
      <p class="fineprint">View counts are the live numbers on each post as of {MEASURED}. Prepared for Paris Baguette Euless.</p>
    </div>
  </footer>

  <script>
    const navToggle = document.getElementById('navToggle') as HTMLButtonElement;
    const mainNav = document.getElementById('mainNav')!;
    navToggle.addEventListener('click', () => {
      const open = mainNav.classList.toggle('open');
      navToggle.setAttribute('aria-expanded', String(open));
    });
    mainNav.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        mainNav.classList.remove('open');
        navToggle.setAttribute('aria-expanded', 'false');
      });
    });
  </script>
</Base>

<style>
  .pb-head { padding-block: 56px 30px; text-align: center; }
  .eyebrow {
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--ink-soft);
  }
  .pb-head h1 {
    font-family: var(--disp); font-weight: 400;
    font-size: clamp(40px, 7.5vw, 78px); line-height: 1.02; margin-top: 10px;
  }
  .pb-head h1 .lit { color: var(--ketchup); }
  .pb-dek { margin: 18px auto 0; color: var(--ink-soft); max-width: 58ch; }
  .cta { margin-top: 26px; display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .cta.left { justify-content: flex-start; margin-top: 28px; }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .stat {
    background: var(--card); border: 2.5px solid var(--ink); border-radius: 8px;
    box-shadow: 4px 4px 0 var(--ink); padding: 20px 18px; text-align: center;
  }
  .stat .v { display: block; font-family: var(--disp); font-size: clamp(22px, 3vw, 32px); line-height: 1.1; color: var(--ink); }
  .stat .l { display: block; margin-top: 8px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-soft); }
  .stamp { margin-top: 14px; font-family: var(--mono); font-size: 12px; color: var(--ink-soft); text-align: center; }

  .panel {
    background: var(--card); border: 2.5px solid var(--ink); border-radius: 10px;
    box-shadow: 5px 5px 0 var(--ink); padding: 30px 32px 32px;
  }
  .panel.wide { margin-top: 18px; }
  .panel .q {
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--ketchup); margin: 0 0 8px;
  }
  .panel h2 { font-family: var(--disp); font-weight: 400; font-size: clamp(24px, 3vw, 31px); line-height: 1.15; }
  .panel p { margin-top: 14px; font-size: 17px; }
  .panel p.small { font-size: 15px; color: var(--ink-soft); }
  .panel a { color: var(--ketchup); text-decoration: none; border-bottom: 2px solid var(--mustard); }
  .panel a:hover { border-color: var(--ketchup); }
  .panel .btn { border-bottom: 2.5px solid var(--ink); }
  .panel .btn.primary { color: var(--card); }

  /* Euless cards */
  .cards {
    list-style: none; margin: 22px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px;
  }
  .cards a {
    display: flex; flex-direction: column; height: 100%;
    background: var(--kraft); border: 2.5px solid var(--ink); border-radius: 8px;
    box-shadow: 4px 4px 0 var(--ink); overflow: hidden; color: var(--ink);
    text-decoration: none; transition: transform .15s, box-shadow .15s;
  }
  .cards a:hover { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--ink); }
  .thumb { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; border-bottom: 2.5px solid var(--ink); background: var(--ink); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; object-position: center 62%; display: block; }
  .thumb .views {
    position: absolute; left: 10px; bottom: 10px;
    font-family: var(--disp); font-size: 22px; line-height: 1;
    color: var(--card); background: var(--ketchup); border: 2px solid var(--ink);
    border-radius: 6px; padding: 6px 10px; box-shadow: 3px 3px 0 var(--ink);
  }
  .thumb .views small { font-family: var(--mono); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; margin-left: 4px; }
  .cards .body { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px 16px; }
  .cards .spot { font-size: 18px; font-weight: 600; line-height: 1.25; }
  .cards .addr { font-family: var(--mono); font-size: 11.5px; letter-spacing: .04em; color: var(--ink-soft); }
  .cards .dist { margin-top: 8px; font-size: 15px; }
  .cards .dist b { color: var(--ketchup); font-weight: 700; }
  .cards .meta { font-family: var(--mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-soft); }
  .cards .note { margin-top: 8px; padding-top: 8px; border-top: 2px dashed #D8CDB4; font-size: 14.5px; color: var(--ink-soft); }

  /* compact DFW list, same as the media kit */
  .vids { list-style: none; margin: 18px 0 0; padding: 0; }
  .vids li + li { border-top: 2px dashed #D8CDB4; }
  .vids a { display: flex; align-items: baseline; gap: 18px; padding: 13px 4px; text-decoration: none; border-bottom: none; color: var(--ink); }
  .vids a:hover .v-title { color: var(--ketchup); }
  .v-views { font-family: var(--disp); font-size: 22px; color: var(--ketchup); min-width: 88px; flex: none; }
  .v-body { display: flex; flex-direction: column; gap: 2px; }
  .v-title { font-size: 17px; font-weight: 600; }
  .v-note { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft); }

  .geo { list-style: none; margin: 18px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; }
  .geo li { display: flex; align-items: baseline; gap: 10px; background: var(--kraft); border: 2px solid var(--ink); border-radius: 8px; padding: 12px 14px; }
  .g-pct { font-family: var(--disp); font-size: 24px; color: var(--ketchup); }
  .g-name { font-size: 15px; }

  .pb-grid { margin-top: 18px; display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .ticks { list-style: none; margin: 12px 0 0; padding: 0; }
  .ticks li { position: relative; padding-left: 22px; margin: 9px 0; font-size: 17px; }
  .ticks li::before { content: "\00b7"; position: absolute; left: 6px; color: var(--ketchup); font-weight: 700; }

  .who { margin: 44px auto 0; padding-bottom: 70px; text-align: center; color: var(--ink-soft); font-size: 16px; }
  .who a { color: var(--ketchup); text-decoration: none; border-bottom: 2px solid var(--mustard); }
  .who a:hover { border-color: var(--ketchup); }

  @media (max-width: 900px) {
    .cards { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 860px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .pb-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .panel { padding: 24px 22px 26px; }
    .cta .btn { width: 100%; text-align: center; }
    .cards { grid-template-columns: 1fr; }
    .vids a { gap: 12px; }
    .v-views { font-size: 19px; min-width: 68px; }
    .v-title { font-size: 16px; }
  }
</style>
