---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
// Microsoft Clarity (analytics standard: Clarity only). Env-gated: no PUBLIC_CLARITY_PROJECT_ID = zero
// scripts. Full IIFE bootstrap is required (a bare tag script throws "a[c] is not a function" and
// collects nothing). Id is read from data-clarity-id so the inline body never changes per id.
const clarityId = (import.meta.env.PUBLIC_CLARITY_PROJECT_ID || '').trim();
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://ashmitbohora.com/#person',
      name: 'Ashmit Bohora',
      url: 'https://ashmitbohora.com/',
      image: ogImage.href,
      email: 'mailto:ashmitbohora@utexas.edu',
      jobTitle: 'Growth Engineer',
      description:
        'UT Austin Statistics & Data Science sophomore (Class of 2029, GPA 3.75) and Growth Engineer at WLF Club, where he owns analytics, tracking, the website, and CRM automation, and replaced a $12,000/yr vendor with software he built. Founder of Webspansion (19 live client sites shipped solo) and Prospansion. Seeking Summer 2027 internships in growth engineering, marketing analytics, product analytics, and data science. US permanent resident, no sponsorship required.',
      worksFor: {
        '@type': 'Organization',
        name: 'WLF Club',
        url: 'https://wlfclub.com',
      },
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'The University of Texas at Austin',
      },
      award: [
        'QuestBridge Finalist (2024)',
        'UT Austin Impact Scholar ($48,000 merit award)',
        // $48,000 Impact + $2,000 Merner = the $50K figure the site shows
        'Thomas & Elizabeth Merner Scholarship in Natural Sciences ($2,000, 2026-2027)',
      ],
      affiliation: {
        '@type': 'CollegeOrUniversity',
        name: 'The University of Texas at Austin',
        url: 'https://www.utexas.edu/',
        sameAs: 'https://en.wikipedia.org/wiki/University_of_Texas_at_Austin',
      },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Austin',
        addressRegion: 'TX',
        addressCountry: 'US',
      },
      birthPlace: {
        '@type': 'Place',
        name: 'Lalitpur, Nepal',
      },
      nationality: {
        '@type': 'Country',
        name: 'Nepal',
      },
      sameAs: [
        'https://github.com/ashmitbohora',
        'https://www.linkedin.com/in/ashmitbohora',
      ],
      knowsAbout: [
        'Data Science',
        'Data Analytics',
        'Growth Engineering',
        'Marketing Analytics',
        'Identity Resolution',
        'Marketing Attribution',
        'Google Analytics 4',
        'Retrieval-Augmented Generation',
        'Answer Engine Optimization',
        'Python',
        'pandas',
        'SQL',
        'TypeScript',
        'React',
        'Next.js',
        'Cloudflare Workers',
        'Software Engineering',
        'AI-assisted Development',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://ashmitbohora.com/#website',
      url: 'https://ashmitbohora.com/',
      name: 'Ashmit Bohora Portfolio',
      author: { '@id': 'https://ashmitbohora.com/#person' },
    },
    {
      '@type': 'ItemList',
      name: 'Projects by Ashmit Bohora',
      itemListElement: [
        {
          '@type': 'SoftwareApplication',
          position: 1,
          name: 'Warvis',
          applicationCategory: 'BusinessApplication',
          description:
            'Internal retrieval-augmented assistant built for WLF Club and hosted for the whole team: BM25 retrieval over 391 allowlisted notes, a weekly report pulling GoHighLevel, QuickBooks, and GA4 into one page, and an identity-resolution dashboard linking anonymous website visits to known CRM contacts. Architected PHI-free and out of HIPAA scope.',
          author: { '@id': 'https://ashmitbohora.com/#person' },
        },
        {
          '@type': 'SoftwareApplication',
          position: 2,
          name: 'WLF Members Platform',
          applicationCategory: 'HealthApplication',
          description:
            'Member platform built in-house on Cloudflare Workers and D1 to replace Heads Up Health, a $12,000/yr vendor: WHOOP and Apple Health sync, a 17-marker labs engine, role-scoped access, a companion native app on TestFlight, and AI routed through Vertex AI under a signed GCP business associate agreement rather than a consumer API.',
          author: { '@id': 'https://ashmitbohora.com/#person' },
        },
        {
          '@type': 'Organization',
          position: 3,
          name: 'Webspansion',
          url: 'https://getwebspansion.org',
          description:
            'Free-tier web studio founded by Ashmit Bohora at 17 (Dec 2023): 19 live client websites built solo, pro bono, for nonprofits, immigrant-owned local businesses, and community groups. Runs on a cookieless first-party analytics platform he engineered on Cloudflare Workers and D1, now tracking 27 client domains.',
          founder: { '@id': 'https://ashmitbohora.com/#person' },
        },
        {
          '@type': 'Organization',
          position: 4,
          name: 'Prospansion',
          url: 'https://prospansion.com',
          description:
            'Paid technical/data arm offering analytics, SEO, and automation; first paid build closed at $999. Flagship product Prospansion Studio is a multi-tenant Cloudflare Workers + D1 CMS with hardened auth and a fixed sanitizer-bypass XSS vulnerability, deployed for nonprofit client Ocura.',
          founder: { '@id': 'https://ashmitbohora.com/#person' },
        },
        {
          '@type': 'SoftwareApplication',
          position: 5,
          name: 'Guruji',
          url: 'https://getguruji.com',
          applicationCategory: 'EducationalApplication',
          description:
            'Free gamified app that teaches beginners to code, replacing $100/month paid tutoring for its first users. React, TypeScript, Supabase, with row-level-security auth, accessibility-verified UI, and a self-run security audit against the live database.',
          author: { '@id': 'https://ashmitbohora.com/#person' },
        },
        {
          '@type': 'SoftwareApplication',
          position: 6,
          name: 'BohoQuest',
          url: 'https://app.bohoquest.app',
          applicationCategory: 'LifestyleApplication',
          description:
            'Gamified check-in app (Expo/React Native) with server-side anti-cheat verification, Apple Sign-In, and a 121-test suite. Live in TestFlight.',
          author: { '@id': 'https://ashmitbohora.com/#person' },
        },
        {
          '@type': 'SoftwareApplication',
          position: 7,
          name: 'Family Assistant',
          url: 'https://family.ashmitbohora.com',
          applicationCategory: 'UtilitiesApplication',
          description:
            'Bilingual English/Nepali retrieval assistant on Cloudflare Workers with signed-cookie auth and rate limiting.',
          author: { '@id': 'https://ashmitbohora.com/#person' },
        },
        {
          '@type': 'SoftwareApplication',
          position: 8,
          name: 'PickMyPath',
          url: 'https://app.pickmypath.app',
          applicationCategory: 'EducationalApplication',
          description:
            'Guitar practice platform with chord-aligned lyrics, a 73-song structured dataset, and a Jaccard-similarity recommender. Live but paused. Next.js, React, TypeScript, PostgreSQL.',
          author: { '@id': 'https://ashmitbohora.com/#person' },
        },
        {
          '@type': 'CreativeWork',
          position: 9,
          name: 'BoHub',
          description:
            'Local-first AI personal OS: Claude API with tiered model routing, SQLite full-text search, prompt-injection defense.',
          author: { '@id': 'https://ashmitbohora.com/#person' },
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#EFE4CD" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Ashmit Bohora" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ashmit Bohora: Full-stack. Literally. UT Austin Statistics & Data Science sophomore and Growth Engineer, seeking Summer 2027 internships." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href="/fonts/caprasimo-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plex-sans-var.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script is:inline defer data-site="portfolio" src="https://webspansion-stats.gamerashmit.workers.dev/snippet.js"></script>
    {clarityId && (
      <script is:inline data-clarity-id={clarityId}>
        (function(){try{var i=document.currentScript.getAttribute("data-clarity-id");if(!i)return;
        (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script",i);
        }catch(e){}})();
      </script>
    )}
</head>
  <body>
    <slot />
  </body>
</html>
