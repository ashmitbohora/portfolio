---
import Base from '../layouts/Base.astro';
---

<Base
  title="404: Not on the menu | Ashmit Bohora"
  description="That page isn't on the menu. Head back to Ashmit Bohora's portfolio."
>
  <main id="main" class="nf-page">
    <div class="wrap">
      <p class="nf-code">404</p>
      <h1>That dish isn't <span class="lit">on the menu.</span></h1>
      <p class="nf-dek">The page you ordered doesn't exist. Maybe it was 86'd, maybe it never made the kitchen.</p>
      <div class="cta">
        <a class="btn primary" href="/">Back to the menu</a>
        <a class="btn" href="mailto:ashmitbohora@utexas.edu">Email me</a>
      </div>
    </div>
  </main>

  <style>
    .nf-page{min-height:80vh;display:flex;align-items:center;text-align:center}
    .nf-page .wrap{width:100%}
    .nf-code{font-family:var(--mono);font-size:13px;letter-spacing:.3em;color:var(--card);background:var(--ketchup);display:inline-block;padding:5px 16px;border-radius:5px;margin-bottom:20px}
    .nf-page h1{font-size:clamp(38px,6vw,64px)}
    .nf-dek{margin:18px auto 28px;color:var(--ink-soft);max-width:44ch}
    .nf-page .cta{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
  </style>
</Base>
