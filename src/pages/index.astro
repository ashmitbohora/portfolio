  <script>
    // Three.js burger — lazy-loaded only when the scrolly approaches the viewport.
    // The scene lives in src/scripts/burger.ts (static `three` import there keeps
    // Rollup tree-shaking working; a dynamic import('three') here defeats it).
    const stack = document.getElementById('stack')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let started = false;

    async function start() {
      if (started) return;
      started = true;
      try {
        const { initBurger } = await import('../scripts/burger');
        initBurger(stack, reduced);
      } catch {
        // WebGL unavailable: drop the js class so the page collapses to the exact
        // no-JS layout (pane hidden, single column, chapters full-strength)
        document.documentElement.classList.remove('js');
      }
    }

    const lazyIO = new IntersectionObserver(
      (es) => {
        if (es.some((e) => e.isIntersecting)) {
          lazyIO.disconnect();
          start();
        }
      },
      { rootMargin: '600px 0px' }
    );
    lazyIO.observe(stack);
  </script>

  <script>
    // count-ups + ketchup fill — values stay at their real numbers until the
    // moment they animate, so crawlers and no-JS readers never see zeros
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reducedMotion) {
      const ease = (t: number) => 1 - Math.pow(1 - t, 3);
      const io = new IntersectionObserver(
        (es) =>
          es.forEach((e) => {
            if (!e.isIntersecting) return;
            e.target.querySelectorAll<HTMLElement>('[data-count]').forEach((el, i) => {
              const target = +el.dataset.count!;
              const dur = 1100;
              el.textContent = '0';
              setTimeout(() => {
                const t0 = performance.now();
                (function tk(now: number) {
                  const p = Math.min((now - t0) / dur, 1);
                  el.textContent = String(Math.round(ease(p) * target));
                  if (p < 1) requestAnimationFrame(tk);
                })(t0);
              }, i * 120);
            });
            const f = e.target.querySelector<HTMLElement>('.fill');
            if (f) f.style.width = f.dataset.width!;
            io.unobserve(e.target);
          }),
        { threshold: 0.3 }
      );
      document.querySelectorAll('.receipt,.mission').forEach((el) => io.observe(el));
    } else {
      document.querySelectorAll<HTMLElement>('.fill').forEach((f) => (f.style.width = f.dataset.width!));
    }
  </script>
</Base>
