  <script>
    // Three.js burger, lazy-loaded only when the scrolly approaches the viewport.
    // The scene lives in src/scripts/burger.ts (static `three` import there keeps
    // Rollup tree-shaking working; a dynamic import('three') here defeats it).
    const stack = document.getElementById('stack')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let started = false;

    // mobile nav: hamburger toggle, closes on link click
    const navToggle = document.getElementById('navToggle') as HTMLButtonElement;
    const mainNav = document.getElementById('mainNav')!;
    navToggle.addEventListener('click', () => {
      const open = mainNav.classList.toggle('open');
      navToggle.setAttribute('aria-expanded', String(open));
    });
    mainNav.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        mainNav.classList.remove('open');
        navToggle.setAttribute('aria-expanded', 'false');
      });
    });

    // back to top: appears after scrolling past the hero
    const backToTop = document.getElementById('backToTop') as HTMLButtonElement;
    const toggleBackToTop = () => backToTop.classList.toggle('visible', window.scrollY > 600);
    addEventListener('scroll', toggleBackToTop, { passive: true });
    toggleBackToTop();
    backToTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
    });

    async function start() {
      if (started) return;
      started = true;
      try {
        const { initBurger } = await import('../scripts/burger');
        initBurger(stack, reduced);
      } catch {
        // WebGL unavailable: drop the js class so the page collapses to the exact
        // no-JS layout (pane hidden, single column, chapters full-strength)
        document.documentElement.classList.remove('js');
      }
    }

    const lazyIO = new IntersectionObserver(
      (es) => {
        if (es.some((e) => e.isIntersecting)) {
          lazyIO.disconnect();
          start();
        }
      },
      { rootMargin: '600px 0px' }
    );
    lazyIO.observe(stack);
  </script>

