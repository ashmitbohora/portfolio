---
import Base from '../../layouts/Base.astro';

// Personalized pitch page for Crunchy Center, the fried-chicken truck in the Rancho Rio Eatery lot at
// 2512 Rio Grande St, Austin (West Campus). Inbound email 2026-09-14 (crunchycenter@gmail.com, "Promoting").
// noindex + out of the sitemap: one reader, one link. No pricing on purpose (they name the number first).
// Post view/like counts were pulled live with yt-dlp on the date in MEASURED. Re-pull before editing.
// Their menu/hours came from their DoorDash listing 2026-09-14: hand-breaded fried chicken, 6:00pm to 1:40am.

const TIKTOK = 'https://www.tiktok.com/@.bohobites';
const INSTAGRAM = 'https://www.instagram.com/_bohobites';
const YOUTUBE = 'https://www.youtube.com/@bohobites';
const EMAIL = 'bohobitesofficial@gmail.com';

const MEASURED = 'September 14, 2026';
const ACCOUNT = { followers: '7,240', likes: '122.9K', videos: '63' };

// Austin posts, biggest first. Every one filmed here, most of them walking distance from your lot.
const AUSTIN = [
  { id: '7585000307999001886', spot: 'Bussin’ Buns', addr: 'Austin', views: '60.2K', likes: '4,897', posted: 'December 2025', tag: 'Fried chicken, late night', note: 'Double bun combo and an extra hot tender. Third biggest post on the whole account, and it is your exact menu' },
  { id: '7633292577818578206', spot: 'Halal Hunger', addr: 'S Lamar Blvd, Austin', views: '26.1K', likes: '624', posted: 'April 2026', tag: 'Food truck', note: 'The viral bring-your-own-bag walking taco. Biggest food-truck post on the account' },
  { id: '7545360275680120094', spot: 'Gyro Delicious', addr: 'UT Austin campus', views: '15.6K', likes: '987', posted: 'September 2025', tag: 'Late night', note: 'Episode one of the late-night series' },
  { id: '7569910904716889375', spot: 'Chat Patta Tacos', addr: '2512 Rio Grande St, your lot', views: '10.2K', likes: '275', posted: 'November 2025', tag: 'Rancho Rio Eatery', note: 'Filmed in the same truck lot you are in. Half chicken, half lamb tacos' },
  { id: '7682647126538554655', spot: 'Pinch', addr: 'Littlefield Fountain, UT campus', views: '9.4K', likes: '311', posted: 'September 2026', tag: 'Food truck, 100 Bites no. 2', note: 'Japanese bento truck, extra everything. Posted eight days ago' },
];
const AUSTIN_TOTAL = { posts: '5', views: '121.5K' };

// Fried chicken and hot chicken posts anywhere on the account. This is the format that travels.
const CHICKEN = [
  { id: '7585000307999001886', spot: 'Bussin’ Buns, Austin', views: '60.2K', note: 'Crispy chicken, late night' },
  { id: '7665945296152628493', spot: 'The Red Chickz, Carrollton', views: '57.7K', note: 'Nashville hot chicken tray, filmed before their grand opening' },
  { id: '7581030787110292767', spot: 'Wingstop', views: '19.8K', note: 'Crispy tenders' },
  { id: '7593898881583189279', spot: 'Popeyes', views: '15.9K', note: 'Spicy tenders and wings' },
  { id: '7523829781008256287', spot: 'Dave’s Hot Chicken', views: '10.3K', note: '$50 order' },
];

const SERIES = [
  { n: '1', spot: 'Roppolo’s Pizzeria, the Drag', id: '7680459100878114079' },
  { n: '2', spot: 'Pinch, the bento truck by the fountain', id: '7682647126538554655' },
  { n: '3', spot: 'Al Shami, the shawarma truck on the Drag', id: '7684862045740698911' },
];

const LOGO_ALT = 'BohoBites';
---

<Base
  title="BohoBites x Crunchy Center | West Campus, Austin"
  description="BohoBites posts filmed in Austin and West Campus with live view counts, the fried-chicken posts that carry the account, and the 100 Bites of Austin series. Prepared for Crunchy Center at Rancho Rio Eatery."
  noindex={true}
>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site">
    <div class="wrap masthead">
      <a class="title" href="/bohobites/" style="text-decoration:none;color:inherit">Boho<span>Bites</span></a>
      <button class="nav-toggle" id="navToggle" aria-label="Menu" aria-expanded="false" aria-controls="mainNav">
        <span></span><span></span><span></span>
      </button>
      <nav aria-label="Main" id="mainNav">
        <div class="nav-sections">
          <a href="#austin">Austin</a>
          <a href="#chicken">Fried chicken</a>
          <a href="#series">100 Bites</a>
          <a href="#video">The video</a>
          <a href="#next">Next step</a>
          <a href="/bohobites/">Full kit</a>
        </div>
        <div class="nav-icons">
          <a href={TIKTOK} target="_blank" rel="noopener noreferrer" aria-label="BohoBites on TikTok">
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M9.5 1.5v8.3a2.7 2.7 0 1 1-2.2-2.66" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M9.5 3.2c.5 1.6 1.8 2.7 3.4 2.9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          </a>
          <a href={INSTAGRAM} target="_blank" rel="noopener noreferrer" aria-label="BohoBites on Instagram">
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="1.5" y="1.5" width="13" height="13" rx="4" stroke="currentColor" stroke-width="1.4"/><circle cx="8" cy="8" r="3.2" stroke="currentColor" stroke-width="1.4"/><circle cx="11.6" cy="4.4" r="0.9" fill="currentColor"/></svg>
          </a>
          <a href={YOUTUBE} target="_blank" rel="noopener noreferrer" aria-label="BohoBites on YouTube">
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="1" y="3.5" width="14" height="9" rx="3" stroke="currentColor" stroke-width="1.4"/><path d="M6.7 6.2l3.6 1.8-3.6 1.8V6.2z" fill="currentColor"/></svg>
          </a>
        </div>
      </nav>
    </div>
  </header>

  <main id="main" tabindex="-1">

    <div class="wrap pb-head">
      <p class="eyebrow">For Crunchy Center, Rancho Rio Eatery, West Campus</p>
      <h1>I live on <span class="lit">your block.</span></h1>
      <p class="pb-dek">
        BohoBites is a UT student food account, and I walk past the Rio Grande truck lot most days.
        Fried chicken is the format this account does best: the two biggest restaurant posts are
        both crispy chicken, and one of them was a late-night Austin run. You are already at 4.8
        stars on Google with 18 reviews. Here is the account for
        your side of campus, with the live numbers on every post.
      </p>
      <div class="cta">
        <a class="btn primary" href="#austin">See the Austin videos</a>
        <a class="btn" href="#next">Next step</a>
      </div>
    </div>

    <div class="wrap">
      <section class="stats" aria-label="BohoBites in Austin">
        <div class="stat">
          <span class="v">{AUSTIN_TOTAL.posts}</span>
          <span class="l">Austin spots below</span>
        </div>
        <div class="stat">
          <span class="v">{AUSTIN_TOTAL.views}</span>
          <span class="l">Views on those five</span>
        </div>
        <div class="stat">
          <span class="v">60.2K</span>
          <span class="l">Best Austin post, fried chicken</span>
        </div>
        <div class="stat">
          <span class="v">3</span>
          <span class="l">100 Bites of Austin posted so far</span>
        </div>
      </section>
      <p class="stamp">
        Account: {ACCOUNT.followers} TikTok followers, {ACCOUNT.likes} likes, {ACCOUNT.videos} videos.
        View counts pulled from the live posts on {MEASURED}.
      </p>
    </div>

    <div class="wrap">
      <section class="panel wide" id="austin">
        <p class="q">Closest to you</p>
        <h2>Filmed in Austin</h2>
        <p>
          Five spots, three of them trucks, one of them in your own lot. Every post has the full
          street address in the caption so people can actually walk over. Tap any card to watch it.
        </p>
        <ul class="cards" aria-label="Videos filmed in Austin">
          {AUSTIN.map((v) => (
            <li>
              <a href={`${TIKTOK}/video/${v.id}`} target="_blank" rel="noopener noreferrer">
                <span class="thumb">
                  <img src={`/bohobites-posts/${v.id}.jpg`} alt={`Cover frame from the ${v.spot} video`} width="360" height="640" loading="lazy" decoding="async" />
                  <span class="views">{v.views} <small>views</small></span>
                </span>
                <span class="body">
                  <span class="spot">{v.spot}</span>
                  <span class="addr">{v.addr}</span>
                  <span class="dist"><b>{v.tag}</b></span>
                  <span class="meta">{v.likes} likes, posted {v.posted}</span>
                  <span class="note">{v.note}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p class="small">
          Plus the UT late-night series from last fall: J2 at midnight (11.6K), Jesta&rsquo; Pizza
          (4.7K), and a P. Terry&rsquo;s run (18.2K). The audience for those is the same people who
          walk past your window at 1am.
        </p>
      </section>
    </div>

    <div class="wrap">
      <section class="panel wide" id="chicken">
        <h2>Fried chicken is the format that travels</h2>
        <p>
          Across the whole account, crispy chicken posts are the ones that break out. Your zinger
          sandwich and the chicken over mac and cheese are exactly what these videos are built
          around.
        </p>
        <ol class="vids">
          {CHICKEN.map((v) => (
            <li>
              <a href={`${TIKTOK}/video/${v.id}`} target="_blank" rel="noopener noreferrer">
                <span class="v-views">{v.views}</span>
                <span class="v-body">
                  <span class="v-title">{v.spot}</span>
                  <span class="v-note">{v.note}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
        <p class="small">
          The Red Chickz post was a brand-new hot chicken spot in DFW, filmed before it opened. It
          became the most-watched restaurant visit on the account. Bussin&rsquo; Buns is the Austin
          version of the same thing.
        </p>
      </section>
    </div>

    <div class="wrap">
      <section class="panel wide" id="series">
        <p class="q">Running right now</p>
        <h2>Boho&rsquo;s 100 Bites of Austin</h2>
        <p>
          A numbered series: one hundred spots walkable from UT, one at a time, every post tagged
          with the number on screen. It started September 1 and three are up, with the next few
          already filmed. Your truck would be the next number in the series, which means the post
          carries the whole series&rsquo; audience, not just a one-off.
        </p>
        <ol class="vids">
          {SERIES.map((s) => (
            <li>
              <a href={`${TIKTOK}/video/${s.id}`} target="_blank" rel="noopener noreferrer">
                <span class="v-views">no. {s.n}</span>
                <span class="v-body">
                  <span class="v-title">{s.spot}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
        <p class="small">
          Honest note: the series is two weeks old, so these three are still climbing. The Pinch
          post is at 9.4K after eight days.
        </p>
      </section>
    </div>

    <div class="wrap pb-one">
      <section class="panel wide" id="video">
        <h2>What you get</h2>
        <p>
          One continuous visit, filmed on smart glasses, so the viewer sees your window, the
          breading and the first bite exactly the way I did. The audio is the real lot. Nothing is
          narrated over the top afterward. I order what you tell me your best plate is, and I say
          what I actually thought, which is why the numbers above exist.
        </p>
        <p>
          The series is free, I pick those spots myself, and there are seventy-eight on my list.
          A promo is different in two ways:
        </p>
        <ul class="ticks">
          <li>It happens this month, on your night. The free series gets to a spot whenever I get to it. Three are posted and the list is long.</li>
          <li>It is built around your plate and your caption. You pick what I order, and the caption pushes your address, your hours and whatever you want out there. What I say about the food is still what I actually thought. That is the deal, and it is why the numbers above exist.</li>
        </ul>
        <p class="small">Filmed at night, when your lot is actually busy, since you run until 1:40am.</p>
      </section>
    </div>

    <div class="wrap">
      <section class="panel wide" id="next">
        <h2>Next step</h2>
        <p>
          I can walk over any evening this month. Reply with what you had in mind for the video and
          the budget you are working with, and I will lock a night.
        </p>
        <div class="cta left">
          <a class="btn primary" href={`mailto:${EMAIL}?subject=Crunchy%20Center%20x%20BohoBites`}>{EMAIL}</a>
          <a class="btn" href={TIKTOK} target="_blank" rel="noopener noreferrer">@.bohobites on TikTok</a>
          <a class="btn" href="/bohobites/">Full media kit</a>
        </div>
      </section>
    </div>

    <div class="wrap who">
      <p>
        BohoBites is made by <a href="/">Ashmit Bohora</a>, a UT Austin student. I film it, edit it,
        and read the numbers behind it myself.
      </p>
    </div>

  </main>

  <footer class="site">
    <div class="wrap">
      <p class="sig">{LOGO_ALT} by <span>Ashmit Bohora</span>, from Euless, now in Austin</p>
      <div class="links">
        <a href="/bohobites/">Media kit</a>
        <a href={TIKTOK} target="_blank" rel="noopener noreferrer">TikTok</a>
        <a href={INSTAGRAM} target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href={YOUTUBE} target="_blank" rel="noopener noreferrer">YouTube</a>
        <a href={`mailto:${EMAIL}`}>Email</a>
      </div>
      <p class="fineprint">View counts are the live numbers on each post as of {MEASURED}. Prepared for Crunchy Center, Austin.</p>
    </div>
  </footer>

  <script>
    const navToggle = document.getElementById('navToggle') as HTMLButtonElement;
    const mainNav = document.getElementById('mainNav')!;
    navToggle.addEventListener('click', () => {
      const open = mainNav.classList.toggle('open');
      navToggle.setAttribute('aria-expanded', String(open));
    });
    mainNav.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        mainNav.classList.remove('open');
        navToggle.setAttribute('aria-expanded', 'false');
      });
    });
  </script>
</Base>

<style>
  .pb-head { padding-block: 56px 30px; text-align: center; }
  .eyebrow {
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--ink-soft);
  }
  .pb-head h1 {
    font-family: var(--disp); font-weight: 400;
    font-size: clamp(40px, 7.5vw, 78px); line-height: 1.02; margin-top: 10px;
  }
  .pb-head h1 .lit { color: var(--ketchup); }
  .pb-dek { margin: 18px auto 0; color: var(--ink-soft); max-width: 58ch; }
  .cta { margin-top: 26px; display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .cta.left { justify-content: flex-start; margin-top: 28px; }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .stat {
    background: var(--card); border: 2.5px solid var(--ink); border-radius: 8px;
    box-shadow: 4px 4px 0 var(--ink); padding: 20px 18px; text-align: center;
  }
  .stat .v { display: block; font-family: var(--disp); font-size: clamp(22px, 3vw, 32px); line-height: 1.1; color: var(--ink); }
  .stat .l { display: block; margin-top: 8px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-soft); }
  .stamp { margin-top: 14px; font-family: var(--mono); font-size: 12px; color: var(--ink-soft); text-align: center; }

  .panel {
    background: var(--card); border: 2.5px solid var(--ink); border-radius: 10px;
    box-shadow: 5px 5px 0 var(--ink); padding: 30px 32px 32px;
  }
  .panel.wide { margin-top: 18px; }
  .panel .q {
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--ketchup); margin: 0 0 8px;
  }
  .panel h2 { font-family: var(--disp); font-weight: 400; font-size: clamp(24px, 3vw, 31px); line-height: 1.15; }
  .panel p { margin-top: 14px; font-size: 17px; }
  .panel p.small { font-size: 15px; color: var(--ink-soft); }
  .panel a { color: var(--ketchup); text-decoration: none; border-bottom: 2px solid var(--mustard); }
  .panel a:hover { border-color: var(--ketchup); }
  .panel .btn { border-bottom: 2.5px solid var(--ink); }
  .panel .btn.primary { color: var(--card); }

  /* Euless cards */
  .cards {
    list-style: none; margin: 22px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px;
  }
  .cards a {
    display: flex; flex-direction: column; height: 100%;
    background: var(--kraft); border: 2.5px solid var(--ink); border-radius: 8px;
    box-shadow: 4px 4px 0 var(--ink); overflow: hidden; color: var(--ink);
    text-decoration: none; transition: transform .15s, box-shadow .15s;
  }
  .cards a:hover { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--ink); }
  .thumb { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; border-bottom: 2.5px solid var(--ink); background: var(--ink); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; object-position: center 62%; display: block; }
  .thumb .views {
    position: absolute; left: 10px; bottom: 10px;
    font-family: var(--disp); font-size: 22px; line-height: 1;
    color: var(--card); background: var(--ketchup); border: 2px solid var(--ink);
    border-radius: 6px; padding: 6px 10px; box-shadow: 3px 3px 0 var(--ink);
  }
  .thumb .views small { font-family: var(--mono); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; margin-left: 4px; }
  .cards .body { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px 16px; }
  .cards .spot { font-size: 18px; font-weight: 600; line-height: 1.25; }
  .cards .addr { font-family: var(--mono); font-size: 11.5px; letter-spacing: .04em; color: var(--ink-soft); }
  .cards .dist { margin-top: 8px; font-size: 15px; }
  .cards .dist b { color: var(--ketchup); font-weight: 700; }
  .cards .meta { font-family: var(--mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-soft); }
  .cards .note { margin-top: 8px; padding-top: 8px; border-top: 2px dashed #D8CDB4; font-size: 14.5px; color: var(--ink-soft); }

  /* compact DFW list, same as the media kit */
  .vids { list-style: none; margin: 18px 0 0; padding: 0; }
  .vids li + li { border-top: 2px dashed #D8CDB4; }
  .vids a { display: flex; align-items: baseline; gap: 18px; padding: 13px 4px; text-decoration: none; border-bottom: none; color: var(--ink); }
  .vids a:hover .v-title { color: var(--ketchup); }
  .v-views { font-family: var(--disp); font-size: 22px; color: var(--ketchup); min-width: 88px; flex: none; }
  .v-body { display: flex; flex-direction: column; gap: 2px; }
  .v-title { font-size: 17px; font-weight: 600; }
  .v-note { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft); }

  .tablewrap { overflow-x: auto; margin-top: 18px; -webkit-overflow-scrolling: touch; }
  .geo-table { width: 100%; border-collapse: collapse; min-width: 560px; font-size: 15px; }
  .geo-table th, .geo-table td { text-align: left; padding: 10px 10px; border-bottom: 2px dashed #D8CDB4; vertical-align: top; }
  .geo-table thead th { font-family: var(--mono); font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft); border-bottom: 2.5px solid var(--ink); }
  .geo-table tbody th { font-weight: 600; }
  .geo-table tbody th .sub { display: block; font-family: var(--mono); font-size: 10.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-soft); font-weight: 400; margin-top: 2px; }
  .geo-table td { font-family: var(--mono); font-size: 14px; }
  .geo-table td.tot { font-family: var(--disp); font-size: 20px; color: var(--ketchup); }
  .geo-table td.cities { font-family: var(--sans); font-size: 15px; }
  .geo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; margin-top: 8px; }
  .geo-grid h3 { font-family: var(--mono); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-soft); margin-top: 26px; }
  .stamp-left { margin-top: 22px; font-family: var(--mono); font-size: 12px; color: var(--ink-soft); }
  .geo { list-style: none; margin: 12px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
  .geo li { display: flex; align-items: baseline; gap: 10px; background: var(--kraft); border: 2px solid var(--ink); border-radius: 8px; padding: 12px 14px; }
  .g-pct { font-family: var(--disp); font-size: 24px; color: var(--ketchup); }
  .g-name { font-size: 15px; }

  .pb-one { margin-top: 0; }
  .ticks { list-style: none; margin: 12px 0 0; padding: 0; }
  .ticks li { position: relative; padding-left: 22px; margin: 9px 0; font-size: 17px; }
  .ticks li::before { content: "\00b7"; position: absolute; left: 6px; color: var(--ketchup); font-weight: 700; }

  .who { margin: 44px auto 0; padding-bottom: 70px; text-align: center; color: var(--ink-soft); font-size: 16px; }
  .who a { color: var(--ketchup); text-decoration: none; border-bottom: 2px solid var(--mustard); }
  .who a:hover { border-color: var(--ketchup); }

  @media (max-width: 900px) {
    .cards { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 860px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .geo-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .panel { padding: 24px 22px 26px; }
    .cta .btn { width: 100%; text-align: center; }
    .cards { grid-template-columns: 1fr; }
    .vids a { gap: 12px; }
    .v-views { font-size: 19px; min-width: 68px; }
    .v-title { font-size: 16px; }
  }
</style>
