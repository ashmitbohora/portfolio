>
  <a class="skip-link" href="#numbers">Skip to the facts</a>

  <header class="site">
    <div class="wrap masthead">
      <span class="title">Ashmit<span>’s</span></span>
      <nav aria-label="Main">
        <a href="#stack">The Stack</a>
        <a href="#numbers">Numbers</a>
        <a href="#sides">Sides</a>
